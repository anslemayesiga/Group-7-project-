{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure",
            "type": "process",
            "command": "${env:LOCALAPPDATA}/Microsoft/WinGet/Packages/Kitware.CMake_Microsoft.Winget.Source_8wekyb3d8bbwe/cmake-4.4.4-windows-x86_64/bin/cmake.exe",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-G", "MinGW Makefiles",
                "-DCMAKE_CXX_COMPILER=C:/msys64/ucrt64/bin/g++.exe"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "CMake: build",
            "type": "process",
            "command": "${env:LOCALAPPDATA}/Microsoft/WinGet/Packages/Kitware.CMake_Microsoft.Winget.Source_8wekyb3d8bbwe/cmake-4.4.4-windows-x86_64/bin/cmake.exe",
            "args": ["--build", "${workspaceFolder}/build", "--parallel", "4"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "CMake: configure",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "CMake: test",
            "type": "process",
            "command": "${env:LOCALAPPDATA}/Microsoft/WinGet/Packages/Kitware.CMake_Microsoft.Winget.Source_8wekyb3d8bbwe/cmake-4.4.4-windows-x86_64/bin/ctest.exe",
            "args": ["--test-dir", "${workspaceFolder}/build", "--output-on-failure"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "CMake: build",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Build OOP demo",
            "type": "process",
            "command": "g++",
            "args": [
                "-std=c++17", "-Wall", "-Wextra", "-Wpedantic", "-I", "include",
                "src/MinMaxScaler.cpp", "src/data_loader.cpp", "src/gradient_descent.cpp",
                "src/linear_regression.cpp", "src/matrix.cpp", "src/metrics.cpp",
                "src/normal_equation.cpp", "src/ridge_regression.cpp",
                "src/ridge_regression_cost.cpp", "src/tuning.cpp", "examples/oop_demo.cpp",
                "-o", "oop_demo.exe"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$gcc",
            "group": "build"
        },
        {
            "label": "Build ridge demo",
            "type": "process",
            "command": "g++",
            "args": [
                "-std=c++17", "-Wall", "-Wextra", "-Wpedantic", "-I", "include",
                "src/MinMaxScaler.cpp", "src/data_loader.cpp", "src/gradient_descent.cpp",
                "src/linear_regression.cpp", "src/matrix.cpp", "src/metrics.cpp",
                "src/normal_equation.cpp", "src/ridge_regression.cpp",
                "src/ridge_regression_cost.cpp", "src/tuning.cpp", "examples/ridge_demo.cpp",
                "-o", "ridge_demo.exe"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build DataLoader check",
            "type": "process",
            "command": "g++",
            "args": [
                "-std=c++17", "-Wall", "-Wextra", "-Wpedantic", "-I", "include",
                "src/MinMaxScaler.cpp", "src/data_loader.cpp", "src/gradient_descent.cpp",
                "src/linear_regression.cpp", "src/matrix.cpp", "src/metrics.cpp",
                "src/normal_equation.cpp", "src/ridge_regression.cpp",
                "src/ridge_regression_cost.cpp", "src/tuning.cpp", "tests/test_data_loader.cpp",
                "-o", "test_data_loader.exe"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$gcc"
        }
    ]
}
