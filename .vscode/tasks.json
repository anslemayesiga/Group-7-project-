{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure RidgeLib",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build-mingw",
                "-G",
                "MinGW Makefiles",
                "-DCMAKE_CXX_COMPILER=C:/msys64/ucrt64/bin/g++.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build RidgeLib",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-mingw",
                "--parallel",
                "4"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Configure RidgeLib",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run RidgeLib tests",
            "type": "process",
            "command": "ctest",
            "args": [
                "--test-dir",
                "${workspaceFolder}/build-mingw",
                "--output-on-failure"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build RidgeLib",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Build and run Ridge demo",
            "type": "process",
            "command": "${workspaceFolder}/build-mingw/ridge_demo.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build RidgeLib",
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}