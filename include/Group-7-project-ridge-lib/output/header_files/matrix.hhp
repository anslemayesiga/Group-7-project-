
// Owner: Ayesiga Anslem: small demo of the Matrix class.
#include <iostream>
#include <stdexcept>

#include "../include/Group-7-project-ridge-lib/matrix.hpp"

static void print(const ridge::Matrix& m, const char* name) {
    std::cout << name << " (" << m.rows() << "x" << m.cols() << "):\n";
    for (std::size_t i = 0; i < m.rows(); ++i) {
        for (std::size_t j = 0; j < m.cols(); ++j) std::cout << m(i, j) << "\t";
        std::cout << "\n";
    }
}

int main() {
    ridge::Matrix A(2, 3, {1, 2, 3, 4, 5, 6});
    ridge::Matrix B = A.transpose();   // 3x2
    ridge::Matrix C = A * B;           // 2x2 product
    print(A, "A");
    print(B, "A transposed");
    print(C, "A * A^T");

    ridge::Vector v{1, 1, 1};
    ridge::Vector Av = A.multiply(v);  // matrix-vector product
    std::cout << "A * [1 1 1] = [" << Av[0] << ", " << Av[1] << "]\n";
    std::cout << "dot([1,2,3],[4,5,6]) = " << ridge::dot({1, 2, 3}, {4, 5, 6}) << "\n";

    try {
        ridge::Matrix bad = A * A;     // 2x3 times 2x3: inner sizes differ
    } catch (const std::invalid_argument& e) {
        std::cout << "Caught expected error: " << e.what() << "\n";
    }
}

